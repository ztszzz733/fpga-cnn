+   next_addr<=0;issue_left<=0;consume_left<=0;write_addr<=0;write_data<=0;write_byte<=0;
+   head<=0;tail<=0;return_slot<=0;reserved<=0;pending<=0;got<=0;
+   reply_valid<=0;reply_data<=0;fault<=0;
+  end else begin
+   reply_valid<=0;

+// Same 512x64 synchronous pixel RAM, isolated from DSP register absorption.
+module pw8_pixel_bram #(parameter DEPTH=512, AW=$clog2(DEPTH+1))(
+ input wire clk,clear,wr_en,rd_en,
+ input wire [AW-1:0] wr_addr,rd_addr,
+ input wire [2:0] wr_lane,input wire [7:0] wr_byte,
+ output wire [63:0] rd_data
+);
+ (* ram_style="block" *) logic [63:0] pixels[0:DEPTH-1];
+ logic [63:0] value;
+ always @(posedge clk)if(!clear)begin
+  for(integer p=0;p<8;p++)if(wr_en && wr_lane==p)pixels[wr_addr][p*8+:8]<=wr_byte;
+  if(rd_en)value<=pixels[rd_addr];
+ end
+ assign rd_data=value;

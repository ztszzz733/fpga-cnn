        <mxCell id="p3_124" parent="1" vertex="1" style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#e5e7eb;fontFamily=Microsoft YaHei;fontSize=21;spacing=0;" value="AW / AR：ADDR32、ID6、LEN4、SIZE3、BURST2&#10;LOCK2、CACHE4、PROT3、QOS4、VALID；READY 反向&#10;W：DATA64、STRB8、ID6、LAST、VALID；READY 反向">
          <mxGeometry x="882" y="1468" width="1096" height="154" as="geometry" />

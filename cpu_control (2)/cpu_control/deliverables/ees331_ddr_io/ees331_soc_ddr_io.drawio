        <mxCell id="07_board_clock_20" value="→ DDR_DM[3:0] / 4 bit&#xa;&lt;-&gt; DDR_DQ[31:0] / 32 bit&#xa;&lt;-&gt; DDR_DQS[3:0] / 4 bit&#xa;&lt;-&gt; DDR_DQS_n[3:0] / 4 bit" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#b96500;fontFamily=Microsoft YaHei;fontSize=23;rotation=0;" vertex="1" parent="1">

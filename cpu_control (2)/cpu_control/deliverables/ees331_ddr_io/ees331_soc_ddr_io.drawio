        <mxCell id="07_board_clock_18" value="B · PS专用DDR3引脚   →4 bit  &lt;-&gt;40 bit" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#b96500;fontFamily=Microsoft YaHei;fontSize=25;rotation=0;fontStyle=1;" vertex="1" parent="1">

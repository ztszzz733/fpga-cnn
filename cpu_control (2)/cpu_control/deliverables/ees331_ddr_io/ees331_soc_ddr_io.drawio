          <mxGeometry x="75" y="865" width="390" height="450" as="geometry" />
        </mxCell>
        <mxCell id="07_board_clock_23" value="板外 DDR3 / 1GB" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf3f9;strokeColor=#7890a9;strokeWidth=2;fontColor=#182a40;fontFamily=Microsoft YaHei;fontSize=25;" vertex="1" parent="1">

        <mxCell id="06_axi_control_20" value="→ S_AXI_HP0_ARCACHE[3:0] / 4 bit&#xa;→ S_AXI_HP0_AWPROT[2:0] / 3 bit&#xa;→ S_AXI_HP0_ARPROT[2:0] / 3 bit&#xa;→ S_AXI_HP0_AWQOS[3:0] / 4 bit&#xa;→ S_AXI_HP0_ARQOS[3:0] / 4 bit&#xa;→ S_AXI_HP0_WSTRB[7:0] / 8 bit&#xa;→ S_AXI_HP0_AWVALID / 1 bit&#xa;→ S_AXI_HP0_WVALID / 1 bit&#xa;→ S_AXI_HP0_WLAST / 1 bit&#xa;→ S_AXI_HP0_BREADY / 1 bit&#xa;→ S_AXI_HP0_ARVALID / 1 bit&#xa;→ S_AXI_HP0_RREADY / 1 bit" style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#16805b;fontFamily=Microsoft YaHei;fontSize=22;rotation=0;" vertex="1" parent="1">
          <mxGeometry x="2775" y="455" width="820" height="920" as="geometry" />
        </mxCell>
        <mxCell id="06_axi_control_21" value="响应 ←  ←22 bit" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#16805b;fontFamily=Microsoft YaHei;fontSize=25;rotation=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1905" y="1450" width="1700" height="45" as="geometry" />
        </mxCell>
        <mxCell id="06_axi_control_22" value="← S_AXI_HP0_BID[5:0] / 6 bit&#xa;← S_AXI_HP0_RID[5:0] / 6 bit&#xa;← S_AXI_HP0_BRESP[1:0] / 2 bit&#xa;← S_AXI_HP0_RRESP[1:0] / 2 bit&#xa;← S_AXI_HP0_AWREADY / 1 bit&#xa;← S_AXI_HP0_WREADY / 1 bit&#xa;← S_AXI_HP0_BVALID / 1 bit&#xa;← S_AXI_HP0_ARREADY / 1 bit&#xa;← S_AXI_HP0_RVALID / 1 bit&#xa;← S_AXI_HP0_RLAST / 1 bit" style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#16805b;fontFamily=Microsoft YaHei;fontSize=22;rotation=0;" vertex="1" parent="1">
          <mxGeometry x="1920" y="1510" width="1670" height="620" as="geometry" />
        </mxCell>
        <mxCell id="06_axi_control_23" value="HP0设置64bit：WDATA/RDATA /64，WSTRB /8；GP0数据 /32，WSTRB /4。&#xa;HP0可选FIFO计数/issue-cap端口非数据事务握手，见第07页；AXI3突发LEN /4，不能直接接AXI4的LEN /8。" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#536479;fontFamily=Microsoft YaHei;fontSize=24;rotation=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="2300" width="3550" height="115" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

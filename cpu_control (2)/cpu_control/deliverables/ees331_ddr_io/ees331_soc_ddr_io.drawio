        <mxCell id="07_board_clock_21" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d5dfe8;strokeWidth=2;fontColor=#182a40;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1">

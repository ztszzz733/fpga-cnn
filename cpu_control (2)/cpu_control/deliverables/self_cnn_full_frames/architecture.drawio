<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="四图固定流程 CNN"><mxGraphModel page="1" pageWidth="1600" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="host" value="外部配置端&lt;br&gt;一份固定流程 + 1~4 张图片地址&lt;br&gt;图片写完后提交 frame_valid" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#f1f5f9" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="40" width="360" height="120" /></mxCell><mxCell id="expand" value="CNN: stream_fixed_programmer&lt;br&gt;模板地址重定位、依赖/owner 展开&lt;br&gt;131 个模板步骤 → 524 个四图任务（容量1024）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dbeafe" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="40" width="430" height="120" /></mxCell><mxCell id="dispatch" value="CNN: stream_dispatch&lt;br&gt;按输入就绪、依赖、槽所有权调度&lt;br&gt;空闲算子池轮转，图片不绑定实例" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dbeafe" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="230" width="430" height="130" /></mxCell><mxCell id="leases" value="CNN: stream_buffer_leases&lt;br&gt;16 个物理工作槽&lt;br&gt;所有消费者完成 + 外部取走后释放" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ede9fe" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="40" width="440" height="120" /></mxCell><mxCell id="results" value="CNN: stream_result_handoff&lt;br&gt;frame / addr / bytes 各 32 位&lt;br&gt;result_ready = 最后读响应已到达" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dcfce7" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="230" width="440" height="130" /></mxCell><mxCell id="ops" value="CNN 算子池（10 个独立 SRAM 客户端）&lt;br&gt;&lt;br&gt;自研 K3 ×4（普通 + DW3）　自研 K1 ×2&lt;br&gt;原 DW7 ×1　原 Post ×1　原 Add ×1　原 Pad ×1&lt;br&gt;&lt;br&gt;operator_work：卷积真实 MAC；其他算子接受输出写回" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dbeafe" vertex="1" parent="1"><mxGeometry as="geometry" x="300" y="470" width="1100" height="170" /></mxCell><mxCell id="sram" value="bai-datasram：16 MiB 仿真容量，4 个真双口 bank&lt;br&gt;A：CPU 固定一拍；B：10 个 CNN 客户端 + 图像 IO 轮转&lt;br&gt;bank=(addr&gt;&gt;2)&amp;3；同字 A 优先；CNN 写等 response，IO 写 gnt 即完成" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffedd5" vertex="1" parent="1"><mxGeometry as="geometry" x="300" y="760" width="1100" height="150" /></mxCell><mxCell id="io" value="外部图像 IO&lt;br&gt;逐张写入 / 结果读出&lt;br&gt;本测试为请求驱动器" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#f1f5f9" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="750" width="230" height="150" /></mxCell><mxCell id="e1" value="template_valid + address_valid" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=13;" edge="1" parent="1" source="host" target="expand"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="program_* / start" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=13;" edge="1" parent="1" source="expand" target="dispatch"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="command[511:0], start / done" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=13;" edge="1" parent="1" source="dispatch" target="ops"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="reserve / buffer_ready" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=13;" edge="1" parent="1" source="dispatch" target="leases"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="external_hold[15:0]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=13;" edge="1" parent="1" source="results" target="leases"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="completed_mask[1023:0]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=13;" edge="1" parent="1" source="dispatch" target="results"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="每客户端 valid/write/byte/addr32/wdata32 → ready/response/rdata32" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=13;" edge="1" parent="1" source="ops" target="sram"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e8" value="req/we/addr/wdata/be → gnt/rvalid/rdata/error" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=13;" edge="1" parent="1" source="io" target="sram"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>
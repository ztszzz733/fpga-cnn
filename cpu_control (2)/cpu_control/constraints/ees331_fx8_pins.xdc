# EES331_UserManual_v1.0_1220: printed pp35-37, J7, PL bank34 at 3.3V.
# Separate RX/TX lanes. No bidirectional tri-state bus. Directions are FPGA-relative.
# J7-21 is PUDC_B and J7-39 is unused: intentionally do not assign either.
set_property PACKAGE_PIN J15 [get_ports {fx8_rx_data[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_rx_data[0]}]
set_property PACKAGE_PIN K15 [get_ports {fx8_rx_data[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_rx_data[1]}]
set_property PACKAGE_PIN J16 [get_ports {fx8_rx_data[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_rx_data[2]}]
set_property PACKAGE_PIN J17 [get_ports {fx8_rx_data[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_rx_data[3]}]
set_property PACKAGE_PIN L16 [get_ports {fx8_rx_data[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_rx_data[4]}]
set_property PACKAGE_PIN L17 [get_ports {fx8_rx_data[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_rx_data[5]}]
set_property PACKAGE_PIN M17 [get_ports {fx8_rx_data[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_rx_data[6]}]
set_property PACKAGE_PIN N17 [get_ports {fx8_rx_data[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_rx_data[7]}]
set_property PACKAGE_PIN N18 [get_ports {fx8_tx_data[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_tx_data[0]}]
set_property PACKAGE_PIN M15 [get_ports {fx8_tx_data[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_tx_data[1]}]
set_property PACKAGE_PIN M16 [get_ports {fx8_tx_data[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_tx_data[2]}]
set_property PACKAGE_PIN J18 [get_ports {fx8_tx_data[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_tx_data[3]}]
set_property PACKAGE_PIN K18 [get_ports {fx8_tx_data[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_tx_data[4]}]
set_property PACKAGE_PIN J21 [get_ports {fx8_tx_data[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_tx_data[5]}]
set_property PACKAGE_PIN J22 [get_ports {fx8_tx_data[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_tx_data[6]}]
set_property PACKAGE_PIN J20 [get_ports {fx8_tx_data[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_tx_data[7]}]
set_property PACKAGE_PIN K21 [get_ports {fx8_rx_ready}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_rx_ready}]
set_property PACKAGE_PIN L21 [get_ports {fx8_rx_valid}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_rx_valid}]
set_property PACKAGE_PIN L22 [get_ports {fx8_tx_ready}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_tx_ready}]
set_property PACKAGE_PIN K19 [get_ports {fx8_tx_valid}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_tx_valid}]
set_property PACKAGE_PIN K20 [get_ports {fx8_clk}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_clk}]
set_property PACKAGE_PIN L19 [get_ports {fx8_reset_n}]
set_property IOSTANDARD LVCMOS33 [get_ports {fx8_reset_n}]
set_property SLEW SLOW [get_ports {fx8_tx_data[*] fx8_tx_valid fx8_rx_ready fx8_reset_n}]
set_property DRIVE 8 [get_ports {fx8_tx_data[*] fx8_tx_valid fx8_rx_ready fx8_reset_n fx8_clk}]
set_property SLEW FAST [get_ports fx8_clk]
